// Offline/local visualization router. Does not discover or connect to a robot.
{
  mode: "router",
  connect: { endpoints: [] },
  listen: { endpoints: ["tcp/127.0.0.1:7447"], exit_on_failure: true },
  scouting: { multicast: { enabled: false }, gossip: { enabled: false } },
  timestamping: { enabled: { router: true, peer: true, client: true }, drop_future_timestamp: false },
}
