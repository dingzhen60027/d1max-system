// All live consumers share ONE robot uplink owned by start_live_monitor.sh.
// Never use the offline bag router (7447) for live localization.
{
  mode: "client",
  connect: { endpoints: ["tcp/127.0.0.1:7448"], exit_on_failure: true },
  scouting: { multicast: { enabled: false }, gossip: { enabled: false } },
  timestamping: { enabled: true, drop_future_timestamp: false },
}
