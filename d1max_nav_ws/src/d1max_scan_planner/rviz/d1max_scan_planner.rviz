Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Cell Size: 1
      Color: 100; 105; 110
      Plane: XY
      Reference Frame: map
    - Class: rviz_default_plugins/PointCloud2
      Name: 3D Occupancy
      Enabled: true
      Topic:
        Value: /d1max/scan/grid_map/occupancy
        Reliability Policy: Best Effort
      Size (Pixels): 2
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Inflated Obstacles
      Enabled: true
      Topic:
        Value: /d1max/scan/grid_map/occupancy_inflate
        Reliability Policy: Best Effort
      Size (Pixels): 3
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 85; 55
      Decay Time: 0
    - Class: rviz_default_plugins/Odometry
      Name: Faster-LIO Odometry
      Enabled: true
      Topic:
        Value: /Odometry
        Reliability Policy: Best Effort
      Shape:
        Axes Length: 0.35
        Axes Radius: 0.025
    - Class: rviz_default_plugins/Marker
      Name: Goal
      Enabled: true
      Topic:
        Value: /d1max/scan/goal_point
    - Class: rviz_default_plugins/Marker
      Name: Global Reference
      Enabled: true
      Topic:
        Value: /d1max/scan/global_list
    - Class: rviz_default_plugins/Marker
      Name: A Star
      Enabled: true
      Topic:
        Value: /d1max/scan/a_star_list
    - Class: rviz_default_plugins/Marker
      Name: Optimized Trajectory
      Enabled: true
      Topic:
        Value: /d1max/scan/optimal_list
    - Class: rviz_default_plugins/Marker
      Name: Sliding Map Bounds
      Enabled: true
      Topic:
        Value: /d1max/scan/grid_map/sliding_map_bbox
  Global Options:
    Background Color: 20; 24; 28
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.55
      Yaw: 0.75
Window Geometry:
  Height: 900
  Width: 1500
