<?xml version="1.0"?>
<!-- Humble BT.CPP v3. No automatic spin, reverse or drive-on-heading recovery.
     Costmap clearing resets observations, not the static occupancy map.
     Command permission and freshness are independently enforced downstream. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="2" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="Plan">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="RefreshGlobalObservations" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="Control">
          <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"/>
          <ClearEntireCostmap name="RefreshLocalObservations" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="Recovery">
        <GoalUpdated/>
        <Sequence name="ClearAndWait">
          <ClearEntireCostmap name="ClearLocal" service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap name="ClearGlobal" service_name="global_costmap/clear_entirely_global_costmap"/>
          <Wait wait_duration="2.0"/>
        </Sequence>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
