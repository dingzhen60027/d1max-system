# The session launcher supplies the current map's view center and scale.
# Launch RViz in /d1max/navigation: the official Nav2 panel/action clients
# inherit that namespace. This file does not connect to any SDK command topic.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: 01 · 单层地图
      Enabled: true
      Value: true
      Alpha: 1.0
      Color Scheme: map
      Draw Behind: true
      Use Timestamp: false
      Topic:
        Value: /d1max/navigation/map
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Name: 02 · 全局代价地图
      Enabled: true
      Value: true
      Alpha: 0.45
      Color Scheme: costmap
      Draw Behind: false
      Use Timestamp: false
      Topic:
        Value: /d1max/navigation/global_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
      Update Topic:
        Value: /d1max/navigation/global_costmap/costmap_updates
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Name: 03 · 局部代价地图
      Enabled: true
      Value: true
      Alpha: 0.60
      Color Scheme: costmap
      Draw Behind: false
      Use Timestamp: false
      Topic:
        Value: /d1max/navigation/local_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
      Update Topic:
        Value: /d1max/navigation/local_costmap/costmap_updates
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: 04 · 全局路径（绿色）
      Enabled: true
      Value: true
      Topic:
        Value: /d1max/navigation/plan
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Buffer Length: 1
      Color: 20; 210; 115
      Alpha: 1.0
      Line Style: Billboards
      Line Width: 0.06
      Pose Style: None
      Offset: {X: 0, Y: 0, Z: 0.08}
    - Class: rviz_default_plugins/Path
      Name: 05 · 局部路径（蓝色）
      Enabled: true
      Value: true
      Topic:
        Value: /d1max/navigation/local_plan
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Buffer Length: 1
      Color: 0; 155; 255
      Alpha: 1.0
      Line Style: Billboards
      Line Width: 0.04
      Pose Style: None
      Offset: {X: 0, Y: 0, Z: 0.10}
    - Class: rviz_default_plugins/Polygon
      Name: 06 · 碰撞包络
      Enabled: true
      Value: true
      Color: 255; 165; 35
      Alpha: 1.0
      Topic:
        Value: /d1max/navigation/local_costmap/published_footprint
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: rviz_default_plugins/LaserScan
      Name: 07 · 障碍观测
      Enabled: true
      Value: true
      Topic:
        Value: /d1max/navigation/scan
        Depth: 1
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 80; 80
      Alpha: 0.9
      Style: Points
      Size (Pixels): 3
      Size (m): 0.035
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Odometry
      Name: 08 · 机身位姿
      Enabled: true
      Value: true
      Topic:
        Value: /d1max/localization/odometry/global
        Depth: 1
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Keep: 1
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape:
        Value: Arrow
        Color: 240; 100; 30
        Alpha: 1
        Shaft Length: 0.65
        Shaft Radius: 0.025
        Head Length: 0.25
        Head Radius: 0.10
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Path
      Name: 09 · 已行走轨迹
      Enabled: true
      Value: true
      Topic:
        Value: /d1max/localization/trajectory
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Buffer Length: 1
      Color: 160; 80; 210
      Alpha: 0.9
      Line Style: Billboards
      Line Width: 0.02
      Pose Style: None
      Offset: {X: 0, Y: 0, Z: 0.12}
    - Class: rviz_default_plugins/Marker
      Name: 10 · 会话与安全状态
      Enabled: true
      Value: true
      Topic:
        Value: /d1max/navigation/test_status
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Name: 多航点
      Enabled: true
      Value: true
      Topic:
        Value: /d1max/navigation/waypoints
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
    - Class: rviz_default_plugins/Marker
      Name: SIM · 离线闭环状态（非实机定位）
      Enabled: true
      Value: true
      Topic:
        Value: /d1max/navigation/simulation_status
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
    - Class: rviz_default_plugins/PointCloud2
      Name: 实时 3D 点云（实机可选）
      Enabled: false
      Value: false
      Topic:
        Value: /d1max/localization/lio/deskewed
        Depth: 1
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 0; 165; 210
      Alpha: 0.6
      Style: Points
      Size (Pixels): 1
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: 初始位姿预览（实机）
      Enabled: true
      Value: true
      Topic:
        Value: /d1max/localization/scan_initial_preview
        Depth: 1
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 235; 145; 35
      Alpha: 0.7
      Style: Points
      Size (Pixels): 2
      Decay Time: 0.5
      Use Fixed Frame: true
  Global Options:
    Background Color: 35; 39; 46
    Fixed Frame: d1max_loc_map
    Frame Rate: 20
  Name: root
  Enabled: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.068538919
      Topic:
        Value: /d1max/navigation/initialpose
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: nav2_rviz_plugins/GoalTool
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Navigation
      Angle: 0
      Scale: 12.0
      Target Frame: <Fixed Frame>
      X: -32.7
      Y: 17.15
      Near Clip Distance: 0.01
      Invert Z Axis: false
    Saved: ~
Window Geometry:
  Width: 2400
  Height: 1500
  X: 10
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: true
