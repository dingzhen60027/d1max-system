<?xml version="1.0"?>
<package format="3">
  <name>d1max_slam</name>
  <version>0.1.0</version>
  <description>D1 Max dual Airy96 lidar adapters and SLAM launch integration.</description>
  <maintainer email="dndx@example.com">dndx</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>livox_ros_driver2</depend>

  <exec_depend>fastlio2</exec_depend>
  <exec_depend>faster_lio</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
