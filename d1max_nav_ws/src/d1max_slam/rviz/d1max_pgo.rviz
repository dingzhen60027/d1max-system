Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Reference Frame: map
    - Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Name: PGO Optimized Map
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.035
      Style: Points
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /d1max/pgo/map
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Color: 255; 176; 0
      Color Transformer: FlatColor
      Decay Time: 1.5
      Enabled: true
      Name: Live Registered Cloud
      Position Transformer: XYZ
      Queue Size: 3
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 3
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /d1max/faster_lio/cloud_registered
      Use Fixed Frame: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 30; 220; 120
      Enabled: true
      Head Diameter: 0.18
      Head Length: 0.12
      Line Style: Lines
      Line Width: 0.04
      Name: Optimized Path
      Pose Style: None
      Shaft Diameter: 0.08
      Shaft Length: 0.10
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /d1max/pgo/path
    - Alpha: 0.55
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 235; 70; 55
      Enabled: false
      Line Style: Lines
      Line Width: 0.02
      Name: Raw Faster-LIO Path
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /d1max/faster_lio/path
  Enabled: true
  Global Options:
    Background Color: 8; 12; 16
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 24
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Mapping Overview
      Pitch: 0.75
      Target Frame: map
      Yaw: 0.75
Window Geometry:
  Height: 900
  Width: 1440
