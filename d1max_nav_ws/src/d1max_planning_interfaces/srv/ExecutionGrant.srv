# Request/revoke one grant. A successful RPC only queues the transaction.
ExecutionVersion version
string execution_id
uint64 control_epoch
string confirmation_id
string request_id
string sdk_session
string acceptance_record_sha256
builtin_interfaces/Time source_stamp
bool activate
string transport_mode
---
bool accepted
bool duplicate
string sdk_session
uint64 sdk_arm_generation
string reason
# Exact RPC transaction echo. Old/default replies carry no non-admission proof.
ExecutionVersion version
string execution_id
uint64 control_epoch
string request_id
string transport_mode
# SDK-owned fact only: this exact request was never installed. Any prior
# execution retains its own binding and stop obligation. This is NOT a
# measured-stop report or motion authorization.
bool definitely_not_admitted
