<?xml version="1.0"?>
<package format="3">
  <name>d1max_planning_interfaces</name>
  <version>0.1.0</version>
  <description>Session and generation-bound PCT to SCAN planning contracts.</description>
  <maintainer email="dndx@localhost.localdomain">dndx</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
