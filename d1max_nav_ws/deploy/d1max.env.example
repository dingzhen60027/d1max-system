# Filesystem roots for D1 Max navigation; copy to an EnvironmentFile or source it.
# Unset values fall back to the defaults in scripts/d1max_env.sh and
# src/d1max_pct_planner/d1max_pct_planner/paths.py.

# Navigation workspace (this checkout).
#D1MAX_NAV_ROOT=/path/to/d1max_nav_ws

# Unpacked vendor bundle and its d1max_ros2 application tree.
#D1MAX_VENDOR_ROOT=/path/to/vendor_bundle
#D1MAX_APP_ROOT=${D1MAX_VENDOR_ROOT}/d1max_ros2
#D1MAX_ROS2_ENV=${D1MAX_APP_ROOT}/d1max_ros2_env.sh

# Optional explicit sealed release. Otherwise tools/single_floor_entry.sh uses
# the hash-pinned official selection in deploy/single_floor_release.json.
# <release>/release.json names its default map and sealed manifest.
#D1MAX_RELEASE=/path/to/release
#D1MAX_RMW_PREFIX=${D1MAX_APP_ROOT}/local/opt/ros/humble

# Optional overrides.
#PCT_PLANNER_ROOT=${D1MAX_NAV_ROOT}/src/pct_planner_vendor
#D1MAX_GTSAM_PREFIX=/path/to/ros-humble-gtsam/opt/ros/humble
#LIVOX_SDK2_PREFIX=/path/to/livox-sdk2-install
#D1MAX_MAPS_ROOT=${D1MAX_NAV_ROOT}/maps
