/build/
/install/
/log/

# Runtime maps and recordings are large generated artifacts.
/maps/*
!/maps/.gitkeep
*.pcd
*.bag
*.db3
*.mcap

# Faster-LIO writes its trajectory to this fixed source-tree directory.
/src/faster_lio/Log/*
!/src/faster_lio/Log/.gitkeep

__pycache__/
*.py[cod]
.pytest_cache/
.vscode/
.idea/
*~


# Recordings and experiment outputs are data, not source (101G / 7.7G).
/bags/
/experiments/
symlink_install_manifest.txt

# Generated / packaged artifacts.
node_modules/
*.zip

# Independent nested git repo (upstream PCT_planner + local branch d1max/local-*).
/src/pct_planner_vendor/
